; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Atelier Alchemy Core"
config/description="アトリエ錬金術ゲーム v7.0（調合主軸モデル）のコアシステム。庭（仕込み層）・調合（主戦場）・ギルド納品（決算）・工房強化・ランク進行の5システムから成るシングルプレイヤー・ローカル完結のターン制デッキ／リソース管理ゲーム。"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

RngService="*res://autoload/rng_service.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
